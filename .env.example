# VedAstroPy API Environment Variables
# =====================================
# Copy this file to .env and fill in your values

# Database Configuration
USE_FIRESTORE=true

# Firestore Settings (Get from Firebase Console)
FIRESTORE_PROJECT_ID=dev-db-tattva
FIRESTORE_COLLECTION=psychic_profiles

# Path to Firebase Service Account JSON
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=VedAstroPy\firestore-service-account.json

# API Configuration (optional)
# API_PORT=8000
# API_HOST=0.0.0.0
